{
  "name": "@frt/cli",
  "version": "1.0.0",
  "private": true,
  "description": "Developer CLI for Fellowship Run Tracker.",
  "type": "module",
  "exports": {
    "./*.ts": "./src/*.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "git clean -Xdfq -- dist tsconfig.effect.tsbuildinfo",
    "start": "tsx src/main.ts",
    "typecheck": "tsc --project tsconfig.effect.json"
  },
  "dependencies": {
    "@effect/platform-node": "catalog:effect",
    "@frt/api": "workspace:*",
    "@frt/db": "workspace:*",
    "@frt/shared": "workspace:*",
    "effect": "catalog:effect"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:effect",
    "@effect/tsgo-win32-x64": "catalog:effect",
    "@types/node": "catalog:node",
    "typescript": "catalog:typescript"
  }
}
