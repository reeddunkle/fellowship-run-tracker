{
  "name": "@frt/electron",
  "productName": "Fellowship Run Tracker",
  "version": "1.0.0",
  "description": "Track Fellowship runs against configured milestones.",
  "author": "vantra",
  "private": true,
  "main": "dist/bootstrap.js",
  "type": "module",
  "scripts": {
    "build:main": "vite build --config vite.main.config.ts",
    "build:preload": "vite build --config vite.preload.config.ts",
    "build:renderer": "vite build",
    "build": "run-s build:main build:preload build:renderer",
    "clean": "git clean -Xdfq -- dist out",
    "dev:build": "run-s build:main build:preload",
    "dev:renderer": "vite",
    "package": "run-s build package:forge",
    "package:forge": "electron-forge package",
    "make": "run-s build make:forge",
    "make:forge": "electron-forge make",
    "typecheck:renderer": "tsc --project src/renderer/tsconfig.effect.json",
    "typecheck:browser": "tsc --project src/tests/browser/tsconfig.effect.json",
    "typecheck:main": "tsc --project tsconfig.effect.json",
    "typecheck:preload": "tsc --project tsconfig.preload.effect.json",
    "typecheck": "run-s typecheck:renderer typecheck:browser typecheck:main typecheck:preload",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "dependencies": {
    "@frt/api": "workspace:*",
    "@frt/db": "workspace:*",
    "@frt/api-contract": "workspace:*",
    "@frt/shared": "workspace:*",
    "@frt/ui": "workspace:*",
    "@fontsource-variable/geist": "catalog:ui",
    "@tanstack/react-form": "catalog:tanstack",
    "@tanstack/react-query": "catalog:tanstack",
    "@tanstack/react-router": "catalog:tanstack",
    "@tanstack/react-table": "catalog:tanstack",
    "date-fns": "catalog:util",
    "effect": "catalog:effect",
    "lucide-react": "catalog:ui",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "zustand": "catalog:state-management"
  },
  "devDependencies": {
    "@effect/platform-node": "catalog:effect",
    "@effect/tsgo": "catalog:effect",
    "@effect/tsgo-win32-x64": "catalog:effect",
    "@playwright/browser-chromium": "catalog:testing",
    "@standard-schema/spec": "catalog:validation",
    "@tailwindcss/vite": "catalog:tailwind",
    "@tanstack/router-plugin": "catalog:tanstack",
    "@types/node": "catalog:node",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "@vitejs/plugin-react": "catalog:vite",
    "@vitest/browser-playwright": "catalog:testing",
    "@electron-forge/cli": "catalog:electron",
    "@electron-forge/maker-zip": "catalog:electron",
    "@electron-forge/plugin-auto-unpack-natives": "catalog:electron",
    "@electron-forge/plugin-fuses": "catalog:electron",
    "@electron/fuses": "catalog:electron",
    "@vercel/nft": "catalog:electron",
    "electron": "catalog:electron",
    "npm-run-all2": "catalog:tooling",
    "playwright": "catalog:testing",
    "tailwindcss": "catalog:tailwind",
    "tw-animate-css": "catalog:tailwind",
    "typescript": "catalog:typescript",
    "vite": "catalog:vite",
    "vitest": "catalog:testing",
    "vitest-browser-react": "catalog:testing"
  }
}
