# Development-only configuration
# Every setting is optional
# Built-in defaults live in
# `packages/shared/src/app-config/app-config-defaults.ts.`

# Relative paths resolve against the directory the process starts in.

# Address the API server listens on, which the renderer connects to.
# Optional. Default: 127.0.0.1
PUBLIC_API_HOST=127.0.0.1
# Optional. Default: 47891
PUBLIC_API_PORT=47891

# Where unpackaged runs keep their data
# Optional. Default: a separate OS user data directory,
# `fellowship-run-tracker-dev` (e.g. `%LOCALAPPDATA%\fellowship-run-tracker-dev\Data`).
APP_DATA_DIRECTORY=./data

# Optional. Default: `<APP_DATA_DIRECTORY>/database/fellowship-run-tracker.db`
DATABASE_FILENAME="./data/database/fellowship-run-tracker.db"

# Optional. Default: `<APP_DATA_DIRECTORY>/database/state.db`
# STATE_DATABASE_FILENAME="./data/database/state.db"

# Optional. Default: `<APP_DATA_DIRECTORY>/database/fellowship-logs-cache.db`
# FELLOWSHIP_LOGS_CACHE_DATABASE_FILENAME="./data/database/fellowship-logs-cache.db"

# Optional. Default: `<APP_DATA_DIRECTORY>/database/analytics.db`
# ANALYTICS_DATABASE_FILENAME="./data/database/analytics.db"

# Vite dev server for the renderer (`pnpm dev`)
# The root `dev:start` script needs to match these.
# Optional. Default:
ELECTRON_RENDERER_HOST=127.0.0.1
# Optional. Default:
ELECTRON_RENDERER_PORT=5173

# The settings below only seed the app settings when they're first created
# (e.g. a new database). After that, change them in the app instead.

# Optional. Default:
LIVE_SPLIT_HOST=localhost
# Optional. Default:
LIVE_SPLIT_PORT=16834

# Optional. Default:
FELLOWSHIP_LOG_DIRECTORY="C:\Program Files (x86)\Steam\steamapps\common\Fellowship\fellowship\Saved\CombatLogs"

# Read Fellowship Logs reports from local fixtures instead of the API. (Must generate fixtures first.)
# Optional. Default: false
FELLOWSHIP_LOGS_USE_FIXTURES=false
# Where fixture reports are read from and captured to.
# Optional. Default: the api package's `fixtures/fellowship-logs` when running
# from source (CLI, tests). Required for fixtures in Electron, whose bundled
# main process can't locate the api package by itself.
FELLOWSHIP_LOGS_FIXTURE_DIRECTORY=./apps/api/fixtures/fellowship-logs

# Fake Fellowship Logs imports whose report codes start with `SIMULATED-`, and
# show a panel on the Fellowship Logs page (in `pnpm dev`) for queueing them.
# Other imports still run for real.
# Optional. Default: false
FELLOWSHIP_LOGS_SIMULATE_IMPORTS=false

# Minimum level written to the logs (trace, debug, info, warn, error, fatal,
# none).
# The packaged app takes `--log-level=<level>` on launch instead.
# Optional. Default:
# LOG_LEVEL=debug
