{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "compilerOptions": {
    "plugins": [
      {
        "name": "@effect/language-service",
        "noExternal": false,
        "layerGraphFollowDepth": 3,
        "completions": true,
        "namespaceImportPackages": ["effect"],
        "topLevelNamedReexports": "follow",
        "allowedUnstableApis": [
          "@effect/platform-node-shared/NodeSocket",
          "@effect/platform-node/NodeCrypto",
          "@effect/platform-node/NodeFileSystem",
          "@effect/platform-node/NodeHttpClient",
          "@effect/platform-node/NodeHttpServer",
          "@effect/platform-node/NodePath",
          "@effect/platform-node/NodeRuntime",
          "@effect/platform-node/NodeServices",
          "@effect/sql-sqlite-node/SqliteClient",
          "effect/ByteSize",
          "effect/Crypto",
          "effect/FileSystem",
          "effect/cli",
          "effect/http",
          "effect/http-api",
          "effect/Logger",
          "effect/net",
          "effect/observability",
          "effect/Path",
          "effect/persistence",
          "effect/PlatformError",
          "effect/process",
          "effect/reactivity",
          "effect/schema/Model",
          "effect/socket",
          "effect/sql"
        ],
        "effectFn": ["span", "untraced"],
        "diagnosticSeverity": {
          "abortControllerInEffect": "error",
          "acquireReleaseDisposable": "error",
          "allOfMapToForEach": "error",
          "catchAllTagDispatchToCatchTag": "error",
          "catchAllToMapError": "error",
          "catchChainToFirstSuccessOf": "error",
          "catchConditionalRefailToCatchIf": "error",
          "catchDieToOrDie": "error",
          "catchIfTagToCatchTag": "error",
          "catchRefailToTapError": "error",
          "catchTagToCatchReason": "error",
          "catchToIgnore": "error",
          "catchToOrElseSucceed": "error",
          "catchUnfailableEffect": "error",
          "duplicatePackage": "error",
          "effectFnIife": "error",
          "effectFnOpportunity": "error",
          "effectGenUsesAdapter": "error",
          "effectInFailure": "error",
          "effectInVoidSuccess": "error",
          "effectMapFlatten": "error",
          "effectMapVoid": "error",
          "effectSucceedWithVoid": "error",
          "experimentalApiUsage": "error",
          "flatMapConditionalToFilterOrFail": "error",
          "flatMapIgnoredParamToAndThen": "error",
          "flatMapToMap": "error",
          "genericEffectServices": "error",
          "globalErrorInEffectCatch": "error",
          "globalErrorInEffectFailure": "error",
          "layerMergeAllWithDependencies": "error",
          "lazyEffect": "error",
          "lazyPromiseInEffectSync": "error",
          "leakingRequirements": "error",
          "mapSomeToAsSome": "error",
          "matchEffectToMapBoth": "error",
          "matchEffectToMatch": "error",
          "multipleCatchTag": "error",
          "multipleEffectProvide": "error",
          "obsoleteMatchImport": "error",
          "obsoleteSchemaImport": "error",
          "optionMatchToFromOption": "error",
          "outdatedApi": "error",
          "preferSucceedSomeOrNone": "error",
          "preferTypedSchemaDecoder": "error",
          "preferUnsafeConstructor": "error",
          "promiseInEffectSuccess": "error",
          "provideLayerSucceedToProvideService": "error",
          "raceFirstWithSleepToTimeout": "error",
          "redundantMapError": "error",
          "redundantOrDie": "error",
          "redundantSchemaTagIdentifier": "error",
          "returnEffectInGen": "error",
          "runEffectInsideEffect": "error",
          "runOfExitToRunExit": "error",
          "schemaNumber": "error",
          "schemaStructWithTag": "error",
          "schemaSyncInEffect": "error",
          "scopeInLayerEffect": "error",
          "syncToSucceed": "error",
          "timeoutCatchTagToTimeoutOrElse": "error",
          "tryCatchInEffectGen": "error",
          "unknownInEffectCatch": "error",
          "unnecessaryEffectGen": "error",
          "unnecessaryFailYieldableError": "error",
          "unnecessaryPipe": "error",
          "unnecessaryPipeChain": "error",
          "unnecessaryTypeofType": "error",
          "unstableApiUsage": "error"
        },
        "overrides": [
          {
            "include": [
              "apps/*/src/**/*.ts",
              "apps/*/src/**/*.tsx",
              "packages/*/src/**/*.ts",
              "packages/*/src/**/*.tsx"
            ],
            "options": {
              "diagnosticSeverity": {
                "abortControllerInEffect": "warning",
                "asyncFunction": "warning",
                "cryptoRandomUUID": "warning",
                "cryptoRandomUUIDInEffect": "warning",
                "deterministicKeys": "warning",
                "extendsNativeError": "warning",
                "globalConsole": "warning",
                "globalConsoleInEffect": "warning",
                "globalDate": "warning",
                "globalDateInEffect": "warning",
                "globalFetch": "warning",
                "globalFetchInEffect": "warning",
                "globalRandom": "warning",
                "globalRandomInEffect": "warning",
                "globalTimers": "warning",
                "globalTimersInEffect": "warning",
                "instanceOfSchema": "warning",
                "missedPipeableOpportunity": "suggestion",
                "newPromise": "warning",
                "nodeBuiltinImport": "warning",
                "preferSchemaOverJson": "warning",
                "processEnv": "warning",
                "processEnvInEffect": "warning",
                "schemaSync": "warning",
                "serviceNotAsClass": "warning",
                "strictBooleanExpressions": "warning",
                "strictEffectProvide": "warning",

                "missingPipeableSignature": "off",
                "lazyEffect": "off"
              }
            }
          },
          {
            "include": [
              "apps/*/src/tests/**/*.ts",
              "apps/*/src/tests/**/*.tsx",
              "packages/*/src/tests/**/*.ts",
              "packages/*/src/tests/**/*.tsx"
            ],
            "options": {
              "diagnosticSeverity": {
                "asyncFunction": "off",
                "preferSchemaOverJson": "off",
                "schemaSync": "off",
                "strictEffectProvide": "off"
              }
            }
          }
        ]
      }
    ]
  }
}
