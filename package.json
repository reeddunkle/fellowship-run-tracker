{
  "name": "fellowship-run-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "biome:fix": "biome check --write",
    "build": "run-s clean:build generate:catalog-checksums build:package",
    "build:electron": "pnpm -F @frt/electron build",
    "build:package": "pnpm -F @frt/electron make",
    "check": "run-s lint test typecheck knip",
    "clean": "pnpm clean:build && pnpm clean:node-modules",
    "clean:build": "pnpm -r run clean",
    "clean:data": "git clean -Xdfq -- data",
    "clean:node-modules": "pnpm -F @frt/dev-scripts clean:node-modules",
    "cli": "tsx --env-file-if-exists=.env apps/cli/src/main.ts",
    "db:setup": "pnpm cli setup-database",
    "dev": "run-s generate:catalog-checksums dev:electron:build && run-p --race dev:renderer dev:start",
    "dev:electron:build": "pnpm -F @frt/electron dev:build",
    "dev:renderer": "pnpm -F @frt/electron dev:renderer",
    "dev:start": "wait-on tcp:127.0.0.1:5173 && electron apps/electron --renderer-dev-server --env-file=.env",
    "docs:layers:generate": "pnpm -F @frt/api exec tsx ../../tools/dev-scripts/src/generate-layer-graph/generate-layer-graph.ts",
    "docs:layers:render": "pnpm -F @frt/api exec tsx ../../tools/dev-scripts/src/generate-layer-graph/render-layer-graphs.ts",
    "docs:layers": "run-s docs:layers:generate docs:layers:render",
    "fellowship-logs:capture-report": "pnpm cli capture-fellowship-logs-report",
    "format:db-sql:prettier": "pnpm -F @frt/db format:sql:prettier",
    "format:db-sql": "pnpm -F @frt/db format:sql",
    "format:sql": "prettier --write",
    "format:test-sql": "pnpm -F @frt/api format:test-sql",
    "generate:catalog-checksums": "pnpm -F @frt/dev-scripts generate:catalog-checksums",
    "generate:json-schemas": "pnpm -F @frt/json-schemas generate",
    "generate:unit-catalog": "pnpm cli generate-unit-catalog",
    "knip:fix": "knip --fix",
    "knip": "knip",
    "lint:fix": "run-s format:db-sql:prettier format:test-sql biome:fix",
    "lint": "run-s lint:biome lint:comments",
    "lint:biome": "biome check",
    "lint:comments": "oxlint",
    "prepare": "effect-tsgo patch --typescript --no-oxlint",
    "start": "electron apps/electron --env-file=.env",
    "test": "pnpm -r run test",
    "test:browser": "pnpm -F @frt/electron test:browser",
    "test:replay-log-file": "pnpm cli replay-log",
    "typecheck": "run-s typecheck:config typecheck:packages typecheck:electron",
    "typecheck:config": "tsc --project tsconfig.config.json",
    "typecheck:electron": "pnpm -F @frt/electron typecheck",
    "typecheck:packages": "tsc -b tsconfig.packages.json"
  },
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": "24.20.0"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:biome",
    "@effect/tsgo": "catalog:effect",
    "@effect/tsgo-win32-x64": "catalog:effect",
    "@mermaid-js/mermaid-cli": "catalog:mermaid",
    "@types/node": "catalog:node",
    "electron": "catalog:electron",
    "jsonc-parser": "catalog:tooling",
    "knip": "catalog:tooling",
    "npm-run-all2": "catalog:tooling",
    "oxlint": "catalog:tooling",
    "prettier": "catalog:prettier",
    "prettier-plugin-embed": "catalog:prettier",
    "prettier-plugin-sql": "catalog:prettier",
    "shadcn": "catalog:ui",
    "tsx": "catalog:typescript",
    "typescript": "catalog:typescript",
    "wait-on": "catalog:tooling"
  }
}
