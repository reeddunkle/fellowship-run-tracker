{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              ":URL:",
              ":BLANK_LINE:",
              ":PACKAGE_WITH_PROTOCOL:",
              ":BLANK_LINE:",
              [":PACKAGE:", "!@frt/**"],
              ":BLANK_LINE:",
              "@frt/**",
              ":BLANK_LINE:",
              ":ALIAS:",
              ":BLANK_LINE:",
              ":PATH:"
            ]
          }
        },
        "useSortedAttributes": {
          "level": "on",
          "options": {
            "sortOrder": "natural"
          }
        },
        "useSortedKeys": {
          "level": "on",
          "options": {
            "sortOrder": "natural"
          }
        }
      }
    },
    "enabled": true
  },
  "css": {
    "formatter": {
      "enabled": true
    },
    "parser": {
      "tailwindDirectives": true
    }
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**/*.{js,cjs,mjs,ts,tsx,json,jsonc,md,css}",
      "!apps/electron/src/renderer/router/routeTree.gen.ts",
      "!apps/api/src/services/fellowship-logs/fixtures/**/*.{json}",
      "!packages/db/src/catalogs/generated/**/*.{ts}",
      "!packages/json-schemas/generated/**/*.{json}"
    ]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      // "expand": "never",
      "quoteStyle": "double",
      "trailingCommas": "all"
    }
  },
  "json": {
    "assist": {
      "enabled": false
    },
    "formatter": {
      "enabled": true
    },
    "linter": {
      "enabled": true
    },
    "parser": {
      "allowComments": true,
      "allowTrailingCommas": false
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "a11y": {
        "noLabelWithoutControl": {
          "level": "on",
          "options": {
            "inputComponents": ["Input"],
            "labelComponents": ["Label"]
          }
        }
      },
      "nursery": {
        "noContinue": "on",
        "noShadow": "on"
      },
      "performance": {
        "noAccumulatingSpread": "on",
        "noBarrelFile": "on"
      },
      "style": {
        "noEnum": "on",
        "noExportedImports": "on",
        "noParameterAssign": "on",
        "noShoutyConstants": "on",
        "noSubstr": "on",
        "useArrayLiterals": "on",
        "useAsConstAssertion": "on",
        "useAtIndex": "on",
        "useBlockStatements": "on",
        "useConsistentCurlyBraces": "on",
        "useFilenamingConvention": {
          "level": "on",
          "options": {
            "filenameCases": ["kebab-case"]
          }
        },
        "useImportType": {
          "level": "on",
          "options": {
            "style": "inlineType"
          }
        },
        "useSingleVarDeclarator": "on"
      },
      "suspicious": {
        "noDoubleEquals": "on",
        "useIsArray": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/electron/src/renderer/**",
        "apps/electron/src/tests/browser/**/*.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      // Electron main process.
                      "@/bootstrap.ts",
                      "@/main.ts",
                      "@/preload.ts",
                      "@/application/**",
                      "@/ipc/**",
                      "@/runtimes/**",
                      "@/storage/**",
                      "@/services/app-state/app-state-api-service-layer.ts",
                      // API service implementations.
                      "@frt/api/services/**",
                      // Persistence (test fixtures are fine).
                      "@frt/db/**",
                      "!@frt/db/tests/**"
                    ],
                    "message": "Renderer/browser code must not import backend-only implementation modules. Import the matching contract from @frt/api-contract or @frt/shared instead."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ],
  "vcs": {
    "clientKind": "git",
    "enabled": true,
    "useIgnoreFile": true
  }
}
